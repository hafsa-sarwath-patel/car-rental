// -----------------
// Prisma Generator
// -----------------
generator client {
  provider = "prisma-client-js"
  // output = "../src/lib/prisma"  // optional custom output path
}

// -----------------
// Database Source
// -----------------
datasource db {
  provider = "mongodb"
  url      = env("DB_URL")
}


enum Role {
  ADMIN
  USER
  DRIVER
  MECHANIC
  PROVIDER
  CUSTOMER
}

// -----------------
// Core Models
// -----------------


model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  username    String   
  email       String?      // ✅ Add this
  password    String
  role        Role
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


@@unique([username, email])

}

// Brand → Model → Variant hierarchy
model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  models    Model[]
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Model {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  brandId   String   @db.ObjectId
  brand     Brand  @relation(fields: [brandId], references: [id])
  variants  Variant[]
  isActive  Boolean  @default(true)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Variant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  modelId   String   @db.ObjectId
  model     Model    @relation(fields: [modelId], references: [id])
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model State {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  code      String
  status    String  // or use enum Status { Active Inactive }
  cities    City[]  // <-- inverse relation
  providers   Provider[]  // <-- inverse relation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  stateId   String  @db.ObjectId
  status    String  // "Active" or "Inactive"
  state     State   @relation(fields: [stateId], references: [id])
  providers   Provider[]  // <-- inverse relation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



// Checklist hierarchy
model ChecklistCategory {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?            // <- add this line
  options     ChecklistOption[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model ChecklistOption {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?           // optional description
  isActive    Boolean @default(true)  // active flag
  categoryId  String            @db.ObjectId
  category    ChecklistCategory @relation(fields: [categoryId], references: [id])
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}


// Application settings
model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  value     String
  dataType  String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

enum RegistrationStatus {
  PENDING
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

model Provider {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  registration_status RegistrationStatus @default(PENDING)
  name                String
  username            String             @unique
  email               String             @unique
  mobile              String             @unique
  password            String
  alternate_mobile    String?
  address             String?
  cityId              String?            @db.ObjectId
  city                City?              @relation(fields: [cityId], references: [id])
  stateId             String?            @db.ObjectId
  state               State?             @relation(fields: [stateId], references: [id])
  zipcode             String?
  mobileOTP           String?
  emailOTP            String?
  is_active           Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  documents           ProviderDocument[]
}

model DocumentType {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  is_active     Boolean  @default(true)
  forProviders  Boolean  @default(false)
  forCustomers  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  providerDocuments ProviderDocument[]
}

model ProviderDocument {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  providerId      String       @db.ObjectId
  documentTypeId  String       @db.ObjectId
  fileUrl         String
  verified        Boolean      @default(false)
  uploadedAt      DateTime     @default(now())

  provider        Provider     @relation(fields: [providerId], references: [id])
  documentType    DocumentType @relation(fields: [documentTypeId], references: [id])
}
