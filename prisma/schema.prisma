
generator client {
  provider = "prisma-client-js"
}
// ==========================================
// DATABASE CONFIGURATION
// =========================================


datasource db {
  provider = "mongodb"
  url      = env("DB_URL")
}

// ==========================================
// ENUMS
// ==========================================
enum status {
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  EMAIL_VERIFIED
  MOBILE_VERIFIED
  COMPLETED
}

// ==========================================
// CORE ENTITIES
// ==========================================
model users {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  username   String
  password   String
  email      String?
  role       String
  is_active  Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customers  customers[]
  providers  providers[]

  @@unique([username, email])
}

model states {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String
  name      String
  status    status   @default(ACTIVE)
  cities    cities[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model cities {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  state_id  String   @db.ObjectId
  code      String
  name      String
  state     states   @relation(fields: [state_id], references: [id], onDelete: Cascade)
  providers providers[]
  customers customers[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state_id])
}

model brands {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  image     String?
  models    models[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model models {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  brand_id  String   @db.ObjectId
  brand     brands   @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  variants  variants[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand_id])
}

model variants {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  model_id  String   @db.ObjectId
  model     models   @relation(fields: [model_id], references: [id], onDelete: Cascade)
  vehicles  vehicles[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([model_id])
}

// ==========================================
// PROVIDERS & CUSTOMERS
// ==========================================
model providers {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  user_id             String               @db.ObjectId
  city_id             String               @db.ObjectId
  provider_name      String
  email               String?              @unique
  mobile              String?              @unique
  address             String?
  status              status               @default(ACTIVE)
  registration_status RegistrationStatus   @default(PENDING)
  emailOTP            String?
  mobileOTP           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  user                users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  city                cities               @relation(fields: [city_id], references: [id], onDelete: Cascade)
  vehicles            vehicles[]
  provider_documents  provider_documents[]

  @@index([user_id])
  @@index([city_id])
}

model customers {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id     String   @db.ObjectId
  city_id     String   @db.ObjectId
  full_name   String
  email       String?
  mobile      String?
  address     String?
  status      status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  city        cities   @relation(fields: [city_id], references: [id], onDelete: Cascade)
  bookings    vehicle_booking_info[]

  @@index([user_id])
  @@index([city_id])
}

// ==========================================
// VEHICLES
// ==========================================
model vehicles {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  provider_id      String   @db.ObjectId
  variant_id       String   @db.ObjectId
  registration_no  String
  rc_image         String? 
  fuel_type        String
  transmission     String
  color            String?
  seats            Int?
  base_price       Float
  per_km_rate      Float
  status           status   @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  provider         providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  variant          variants  @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  bookings         vehicle_booking_info[]
  vehicle_documents vehicle_documents[]
  inspections      vehicle_inspection_details[]

  @@index([provider_id])
  @@index([variant_id])
}

// ==========================================
// BOOKINGS
// ==========================================
model vehicle_booking_info {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customer_id    String   @db.ObjectId
  vehicle_id     String   @db.ObjectId
  driver_name    String?
  pickup_date    DateTime
  drop_date      DateTime
  pickup_location String
  drop_location  String
  total_amount   Float
  payment_status String
  status         status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  vehicle        vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  payment        vehicle_payment_info?

  @@index([customer_id])
  @@index([vehicle_id])
}

// ==========================================
// PAYMENTS
// ==========================================
model vehicle_payment_info {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  booking_id       String   @unique @db.ObjectId
  transaction_id   String?
  payment_mode     String?
  amount_paid      Float
  payment_date     DateTime @default(now())
  status           status   @default(ACTIVE)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking          vehicle_booking_info @relation(fields: [booking_id], references: [id], onDelete: Cascade)
}

// ==========================================
// DOCUMENTS
// ==========================================
model provider_documents {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  provider_id   String   @db.ObjectId
  document_name String
  document_url  String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider      providers @relation(fields: [provider_id], references: [id], onDelete: Cascade)
}

model vehicle_documents {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicle_id    String   @db.ObjectId
  document_name String
  document_url  String
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle       vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
}

// ==========================================
// INSPECTION
// ==========================================
model vehicle_inspection_details {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  vehicle_id        String   @db.ObjectId
  inspection_date   DateTime @default(now())
  overall_status    String?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vehicle           vehicles @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  inspection_parent inspection_parent[]

  @@index([vehicle_id])
}

model inspection_parent {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  inspection_id      String   @db.ObjectId
  category_id        String   @db.ObjectId
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  inspection         vehicle_inspection_details @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  category           checklist_categories       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  inspection_options inspection_option[]

  @@index([inspection_id])
  @@index([category_id])
}

model checklist_categories {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  status     status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  inspections inspection_parent[]
  options     inspection_option[]
}

model inspection_option {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  parent_id    String   @db.ObjectId
  category_id  String   @db.ObjectId
  option_name  String
  is_ok        Boolean  @default(false)
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent       inspection_parent    @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  category     checklist_categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@index([parent_id])
  @@index([category_id])
}




